<mujoco model="so101_showcase">
  <!-- Tutorial scene wrapper around the upstream SO-101 MJCF
       (TheRobotStudio/SO-ARM100, Apache-2.0). Adds lights, a checker floor,
       and a showcase camera framing the arm for the calibrate_so101 tutorial. -->
  <include file="so101_new_calib.xml"/>

  <visual>
    <global offwidth="960" offheight="960"/>
    <quality shadowsize="4096" offsamples="8"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.62 0.72" rgb2="0.10 0.12 0.16" width="256" height="256"/>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.18 0.20 0.24" rgb2="0.24 0.27 0.31" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light name="key" pos="1.0 -1.0 1.5" dir="-0.6 0.6 -1" directional="true" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-1.0 -0.5 0.8" dir="0.6 0.3 -0.6" directional="true" diffuse="0.3 0.3 0.35"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="grid" contype="0" conaffinity="0"/>
    <camera name="showcase" pos="0.40 -0.40 0.40" xyaxes="1 1 0 -0.4 0.4 1"/>
  </worldbody>
</mujoco>
